{
  "name": "@wayfinder/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node --input-type=module --eval \"await import('./dist/index.js')\"",
    "lint": "eslint src vitest.config.mjs --max-warnings=0",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.build.json --noEmit && tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@wayfinder/contracts": "workspace:*",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  }
}
