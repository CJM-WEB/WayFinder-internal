{
  // 仅构建生产源码；测试继续由完整检查配置校验。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2023"],
    // 生产源码通过显式 node:* 导入使用运行时能力，不注入额外环境全局。
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
