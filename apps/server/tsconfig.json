{
  // 源码与测试共同接受严格检查；Node 类型仅供测试，当前不引入 DOM 环境。
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023"],
    "types": ["node"],
    // 开发期直接检查 Contract 源码；生产运行仍通过 package exports 使用 dist。
    "paths": {
      "@wayfinder/contracts": ["../../packages/contracts/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
