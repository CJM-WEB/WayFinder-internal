{
  // Vite 负责生成浏览器产物；本配置只对生产源码执行严格类型检查。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // 覆盖测试配置继承的 Node 类型，避免生产源码误用环境全局。
    "types": []
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
