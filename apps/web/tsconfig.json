{
  // 源码与测试共同接受严格检查；Node 类型只服务于 Vitest 测试代码。
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // React Flow 与 Dagre 的发布声明暂不兼容本项目的严格 NodeNext 检查；仅跳过依赖声明内部检查，
    // 本应用源码仍继承 strict 与 exactOptionalPropertyTypes，Contract Workspace 也继续独立检查。
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "paths": {
      "@wayfinder/contracts": ["../../packages/contracts/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "e2e/**/*.ts",
    "playwright.config.ts"
  ]
}
