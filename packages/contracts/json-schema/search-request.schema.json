{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "language": {
      "type": "string",
      "enum": [
        "zh-CN",
        "en-US"
      ]
    },
    "engine": {
      "type": "string",
      "enum": [
        "baidu",
        "google"
      ]
    }
  },
  "required": [
    "runId",
    "query",
    "language"
  ],
  "additionalProperties": false
}
