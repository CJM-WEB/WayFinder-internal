{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "language": {
      "type": "string",
      "enum": [
        "zh-CN",
        "en-US"
      ]
    },
    "engine": {
      "type": "string",
      "enum": [
        "baidu",
        "google"
      ]
    },
    "nodeSearch": {
      "type": "object",
      "properties": {
        "node": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "title",
            "description"
          ],
          "additionalProperties": false
        },
        "analysis": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "intent": {
                      "type": "string",
                      "enum": [
                        "learn",
                        "understand",
                        "news",
                        "compare",
                        "shop",
                        "navigate",
                        "how_to",
                        "mixed"
                      ]
                    },
                    "topic": {
                      "type": "string",
                      "minLength": 1
                    },
                    "freshnessSensitive": {
                      "type": "boolean"
                    },
                    "ambiguityLevel": {
                      "type": "string",
                      "enum": [
                        "low",
                        "medium",
                        "high"
                      ]
                    },
                    "presentationMode": {
                      "type": "string",
                      "enum": [
                        "graph",
                        "compact"
                      ]
                    },
                    "broadSearchQueries": {
                      "maxItems": 0,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "strategy": {
                      "type": "string",
                      "const": "plan_first"
                    }
                  },
                  "required": [
                    "intent",
                    "topic",
                    "freshnessSensitive",
                    "ambiguityLevel",
                    "presentationMode",
                    "broadSearchQueries",
                    "strategy"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "intent": {
                      "type": "string",
                      "enum": [
                        "learn",
                        "understand",
                        "news",
                        "compare",
                        "shop",
                        "navigate",
                        "how_to",
                        "mixed"
                      ]
                    },
                    "topic": {
                      "type": "string",
                      "minLength": 1
                    },
                    "freshnessSensitive": {
                      "type": "boolean"
                    },
                    "ambiguityLevel": {
                      "type": "string",
                      "enum": [
                        "low",
                        "medium",
                        "high"
                      ]
                    },
                    "presentationMode": {
                      "type": "string",
                      "enum": [
                        "graph",
                        "compact"
                      ]
                    },
                    "broadSearchQueries": {
                      "minItems": 1,
                      "maxItems": 3,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "strategy": {
                      "type": "string",
                      "const": "evidence_assisted"
                    }
                  },
                  "required": [
                    "intent",
                    "topic",
                    "freshnessSensitive",
                    "ambiguityLevel",
                    "presentationMode",
                    "broadSearchQueries",
                    "strategy"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "node",
        "analysis"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "runId",
    "query",
    "language"
  ],
  "additionalProperties": false
}
