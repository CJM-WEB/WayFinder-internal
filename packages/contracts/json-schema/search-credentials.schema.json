{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "deepseek": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "own"
            },
            "apiKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[\\x20-\\x7E]+$"
            }
          },
          "required": [
            "source",
            "apiKey"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "author"
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "cloud"
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        }
      ]
    },
    "serpapi": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "own"
            },
            "apiKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[\\x20-\\x7E]+$"
            }
          },
          "required": [
            "source",
            "apiKey"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "author"
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "cloud"
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "deepseek",
    "serpapi"
  ],
  "additionalProperties": false
}
