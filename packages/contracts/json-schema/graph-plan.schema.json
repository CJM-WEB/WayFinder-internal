{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "analysis": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "intent": {
              "type": "string",
              "enum": [
                "learn",
                "understand",
                "news",
                "compare",
                "shop",
                "navigate",
                "how_to",
                "mixed"
              ]
            },
            "topic": {
              "type": "string",
              "minLength": 1
            },
            "freshnessSensitive": {
              "type": "boolean"
            },
            "ambiguityLevel": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "presentationMode": {
              "type": "string",
              "enum": [
                "graph",
                "compact"
              ]
            },
            "broadSearchQueries": {
              "maxItems": 0,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "strategy": {
              "type": "string",
              "const": "plan_first"
            }
          },
          "required": [
            "intent",
            "topic",
            "freshnessSensitive",
            "ambiguityLevel",
            "presentationMode",
            "broadSearchQueries",
            "strategy"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "intent": {
              "type": "string",
              "enum": [
                "learn",
                "understand",
                "news",
                "compare",
                "shop",
                "navigate",
                "how_to",
                "mixed"
              ]
            },
            "topic": {
              "type": "string",
              "minLength": 1
            },
            "freshnessSensitive": {
              "type": "boolean"
            },
            "ambiguityLevel": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "presentationMode": {
              "type": "string",
              "enum": [
                "graph",
                "compact"
              ]
            },
            "broadSearchQueries": {
              "minItems": 1,
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "strategy": {
              "type": "string",
              "const": "evidence_assisted"
            }
          },
          "required": [
            "intent",
            "topic",
            "freshnessSensitive",
            "ambiguityLevel",
            "presentationMode",
            "broadSearchQueries",
            "strategy"
          ],
          "additionalProperties": false
        }
      ]
    },
    "nodes": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "nodeType": {
            "type": "string",
            "enum": [
              "primary",
              "related",
              "disambiguation"
            ]
          },
          "layer": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "searchPlan": {
            "type": "object",
            "properties": {
              "queries": {
                "minItems": 1,
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "maxResults": {
                "type": "integer",
                "minimum": 6,
                "maximum": 20
              },
              "rankingProfile": {
                "type": "string",
                "enum": [
                  "knowledge",
                  "news",
                  "shopping",
                  "software",
                  "general"
                ]
              },
              "providerHints": {
                "minItems": 1,
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "general",
                    "news",
                    "shopping",
                    "academic",
                    "code",
                    "community",
                    "finance",
                    "images"
                  ]
                },
                "uniqueItems": true
              }
            },
            "required": [
              "queries",
              "maxResults",
              "rankingProfile",
              "providerHints"
            ],
            "additionalProperties": false
          },
          "status": {
            "type": "string",
            "const": "planned"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "nodeType",
          "layer",
          "searchPlan",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "recommended_next",
              "related_to"
            ]
          }
        },
        "required": [
          "id",
          "source",
          "target",
          "type"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "analysis",
    "nodes",
    "edges"
  ],
  "additionalProperties": false
}
