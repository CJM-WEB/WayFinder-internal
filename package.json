{
  "name": "wayfinder",
  "version": "0.1.0",
  "private": true,
  "description": "WayFinder / 寻径 AI-native browser MVP",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
