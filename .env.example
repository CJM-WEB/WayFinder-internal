# Server（服务端）
PORT=3000

# LLM Provider（大语言模型提供方）；当前仅允许已通过资格验证的组合。
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# Search Provider（搜索提供方）
TAVILY_API_KEY=

# 单次外部调用 Timeout（超时）；实际等待时间还必须受 20 秒全局截止时间约束。
SEARCH_TIMEOUT_MS=8000
EXTRACT_TIMEOUT_MS=10000
PLANNER_TIMEOUT_MS=15000
RERANK_TIMEOUT_MS=12000

# 有界并发；V0 只允许从批准上限向下调整。
SEARCH_CONCURRENCY=6
EXTRACT_CONCURRENCY=3
LLM_CONCURRENCY=3

# Local Run Log（本地运行日志）；共享部署保持关闭，输出目录不可配置。
RUN_LOGGING=false
