# Server（服务端）
PORT=3000

# LLM Provider（大语言模型提供方）；当前仅允许已通过资格验证的组合。
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# Search Provider（搜索提供方）
SERPAPI_API_KEY=

# 作者体验配置文件；空值关闭体验。文件必须位于静态目录之外，仅部署账户可读写。
EXPERIENCE_CONFIG_PATH=
# 正式站点填写 HTTPS 纯 Origin（来源），例如 https://wayfinder.example；空值只开放回环开发来源。
PUBLIC_ORIGIN=

# 单次外部调用 Timeout（超时）；PLANNER 值分别作用于 Planner / Reviser / SearchPlan Generator，全部仍受 40 秒全局截止时间约束。
SEARCH_TIMEOUT_MS=16000
PLANNER_TIMEOUT_MS=30000
RERANK_TIMEOUT_MS=24000

# 有界并发；V0 只允许从批准上限向下调整。
SEARCH_CONCURRENCY=6
LLM_CONCURRENCY=3

# Local Run Log（本地运行日志）；共享部署保持关闭，输出目录不可配置。
RUN_LOGGING=false

# D11 显式迁移入口使用的私有 MySQL URL；空值不启用账号数据库，绝不写真实值进仓库。
# 示例形状 mysql://USER:PASSWORD@HOST:3306/DATABASE；特殊字符必须进行 URL 编码。
WAYFINDER_DATABASE_URL=
# 非回环数据库必须提供可信 CA 文件；证书及主机名严格校验，不能关闭验证。
WAYFINDER_DATABASE_CA_FILE=

# 启用账号时填写独立随机秘密（至少32字符），并配置PUBLIC_ORIGIN；不复用作者签名材料。
WAYFINDER_AUTH_SECRET=
# 标准SMTP：465直接TLS或587强制STARTTLS；开发/CI不得填写真实发送凭据。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 云端Key认证加密主密钥：独立随机32字节的标准Base64，置于DB之外，不复用AUTH_SECRET。
# 空值或格式错误只关闭云Key托管，账号和图仍可用；替换会使旧密文不可读，不在本轮自动轮换。
WAYFINDER_KEY_ENCRYPTION_KEY=
